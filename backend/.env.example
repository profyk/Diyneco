# Runtime
APP_ENV=development                  # development | staging | production
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
LOG_LEVEL=info

# Database (Supabase Postgres). API and worker use their own least-privilege roles.
DATABASE_URL=postgresql+asyncpg://diyneco_api:CHANGE_ME@localhost:5432/diyneco
WORKER_DATABASE_URL=postgresql+asyncpg://diyneco_worker:CHANGE_ME@localhost:5432/diyneco
MIGRATIONS_DATABASE_URL=postgresql+psycopg://diyneco_owner:CHANGE_ME@localhost:5432/diyneco

# Supabase (backend only; never in any frontend build)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
STORAGE_BUCKET_ASSETS=hotel-assets
STORAGE_BUCKET_INVOICES=invoices

# Auth
JWT_SIGNING_KEYS_JSON=CHANGE_ME           # JWK set: current + previous Ed25519 keys with kid
JWT_ACTIVE_KID=CHANGE_ME
PAIRING_CODE_PEPPER=CHANGE_ME
KMS_MASTER_KEY_ID=CHANGE_ME               # wraps per-hotel data keys

# Realtime and jobs
REDIS_URL=redis://localhost:6379/0        # pub/sub fan-out and rate limits; optional in development

# Email
EMAIL_PROVIDER=console               # console | smtp
EMAIL_SMTP_URL=                      # smtp://user@host:587 (STARTTLS) or smtps://user@host:465; password in EMAIL_PROVIDER_KEY
EMAIL_PROVIDER_KEY=CHANGE_ME
EMAIL_FROM="Diyneco <no-reply@diyneco.com>"

# Monitoring
SENTRY_DSN=

# --- Additions not in the runbook (see docs/DECISIONS.md G9) ---
KMS_PROVIDER=local                   # local (development and CI only) | cloud KMS name later
KMS_LOCAL_MASTER_KEY=CHANGE_ME       # base64 of 32 random bytes; only read when KMS_PROVIDER=local

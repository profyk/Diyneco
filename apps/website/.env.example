# API origin (no /api/v1). Read by the server when pages are built and by browsers for the
# contact form and page-view counts.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The Merchant app, for "Sign in" and "Start free trial".
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3001
# Shared with the API's WEBSITE_REVALIDATE_SECRET: publishing in the Admin panel refreshes
# the changed pages at once. Without it pages refresh within 5 minutes.
WEBSITE_REVALIDATE_SECRET=
